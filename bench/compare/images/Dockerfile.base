# The base of every arm: Debian bookworm (Python 3.11), git, Node 22 and the
# Claude Code CLI at one pinned version. The agent runs as `bench`, HOME
# /home/bench. CLAUDE_CONFIG_DIR is left unset, Claude Code's default: with it
# set, Claude Code moves .claude.json inside it, and tools that write
# ~/.claude.json (gentle-ai's context7) would not be seen (DESIGN.md, "Changes
# while building").
ARG NODE_IMAGE
FROM ${NODE_IMAGE}
ARG CLAUDE_CODE_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-venv python-is-python3 git ca-certificates curl tzdata procps jq less \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && npm cache clean --force \
 && useradd --create-home --uid 1001 --shell /bin/bash bench \
 && mkdir -p /remotes /opt/bench && chown bench:bench /remotes /opt/bench
# Claude Code stays at the pinned version in every arm (a change for all arms
# alike, listed in DESIGN.md "Changes while building").
ENV DISABLE_AUTOUPDATER=1 \
    HOME=/home/bench \
    PATH=/home/bench/.local/bin:/usr/local/bin:/usr/bin:/bin \
    LANG=C.UTF-8 \
    TZ=UTC
USER bench
WORKDIR /home/bench
RUN mkdir -p .claude .local/bin work \
 && git config --global user.name bench \
 && git config --global user.email bench@example.invalid \
 && git config --global init.defaultBranch main \
 && claude --version
LABEL org.kontext.bench.claude-code="${CLAUDE_CODE_VERSION}"
